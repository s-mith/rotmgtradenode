{
  "name": "rotmgtradenode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "dev:api": "tsx watch src/server/main.ts",
    "prebuild": "node scripts/build-spritesheet.mjs",
    "build": "vite build && node scripts/precompress.mjs dist/client && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/server/main.js",
    "build:sprites": "node scripts/build-spritesheet.mjs",
    "gen:routes": "node scripts/gen-routes.mjs",
    "sync:equip": "node scripts/sync-equip.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fixtures": "python3 scripts/gen-relay-fixtures.py ../rotmgcommunismpyrelay && python3 scripts/gen-relay-fleet-fixtures.py ../rotmgcommunismpyrelay && python3 scripts/gen-walker-fixtures.py ../accountgen/tutorial-state/pyrelay",
    "build:resources": "node scripts/build-realm-resources.mjs ../accountgen/tutorial-state/pyrelay/Resources",
    "desktop": "node scripts/desktop.mjs run",
    "desktop:pack": "node scripts/desktop.mjs pack",
    "desktop:dist": "node scripts/desktop.mjs dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.3",
    "react-virtuoso": "^4.18.11",
    "sharp": "^0.34.5",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron@44.4.1": true
  },
  "type": "module",
  "description": "Self-hosted RotMG vault: your own alts, your own computer.",
  "license": "MIT",
  "main": "electron/main.mjs",
  "build": {
    "appId": "trade.rotmg.rotmgtradenode",
    "productName": "rotmgtradenode",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**",
      "dist/**",
      "public/**",
      "realm-items.json",
      "realm-enchants.json",
      "package.json",
      "!dist/**/*.map",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "exports": {
    "./shared/*": "./src/shared/*.ts"
  }
}
